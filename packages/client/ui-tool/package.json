{
  "name": "@hackdevcode/dsh-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hackdevcode/dsh-api-workspace-controller",
        "@hackdevcode/dsh-client-connection",
        "@hackdevcode/dsh-client-locale",
        "@hackdevcode/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/dsh-spill-policy": "workspace:*",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-executor-ptc": "workspace:*",
    "@hackdevcode/dsh-tool-jobs": "workspace:*",
    "@hackdevcode/dsh-tool-session-query": "workspace:*",
    "@hackdevcode/dsh-tool-terminal": "workspace:*",
    "@hackdevcode/dsh-spill": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-api-remotes": "workspace:*",
    "@hackdevcode/dsh-client-connection": "workspace:*",
    "@hackdevcode/dsh-client-locale": "workspace:*",
    "@hackdevcode/dsh-client-test-runtime": "workspace:*",
    "@hackdevcode/dsh-client-ui-conversation": "workspace:*",
    "@hackdevcode/dsh-client-ui-primitives": "workspace:*",
    "@hackdevcode/dsh-client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@hackdevcode/dsh-api-workspace-controller": "workspace:*",
    "@hackdevcode/dsh-client-ui-chat": "workspace:*",
    "@hackdevcode/dsh-client-ui-renderer": "workspace:*",
    "@hackdevcode/dsh-client-ui-session": "workspace:*",
    "@hackdevcode/dsh-util-values": "workspace:*",
    "@hackdevcode/dsh-util-workspace-path": "workspace:*",
    "@hackdevcode/dsh-attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@hackdevcode/dsh-ptc-runtime": "workspace:*",
    "@hackdevcode/dsh-token-meter": "workspace:*",
    "@hackdevcode/dsh-user-questions": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
