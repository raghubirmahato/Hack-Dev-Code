{
  "name": "@hackdevcode/dsh-client-ui-plugin-manager",
  "description": "Plugin management for the dsh web client: the sidebar Plugins panel installs, enables, disables, retries, and composes installed plugin packages",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/client/ui-plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hackdevcode/dsh-api-remotes",
        "@hackdevcode/dsh-client-locale",
        "@hackdevcode/dsh-client-ui-layout",
        "@hackdevcode/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-api-remote-access": "workspace:*",
    "@hackdevcode/dsh-api-remotes": "workspace:*",
    "@hackdevcode/dsh-client-locale": "workspace:*",
    "@hackdevcode/dsh-client-store": "workspace:*",
    "@hackdevcode/dsh-client-test-runtime": "workspace:*",
    "@hackdevcode/dsh-client-ui-layout": "workspace:*",
    "@hackdevcode/dsh-client-ui-primitives": "workspace:*",
    "@hackdevcode/dsh-client-ui-renderer": "workspace:*",
    "@hackdevcode/dsh-client-ui-sidebar": "workspace:*",
    "@hackdevcode/dsh-client-ui-slots": "workspace:*",
    "@hackdevcode/dsh-official-bundles": "workspace:*",
    "@hackdevcode/dsh-package-manifest": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@hackdevcode/dsh-util-crypto": "workspace:*",
    "@hackdevcode/dsh-client-ui-settings": "workspace:*",
    "@hackdevcode/dsh-plugin-manager": "workspace:*",
    "@hackdevcode/dsh-client-product-analytics": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@hackdevcode/dsh-timeout": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~",
    "zod": "4.4.3",
    "@hackdevcode/dsh-typert-protocol": "workspace:*"
  }
}
