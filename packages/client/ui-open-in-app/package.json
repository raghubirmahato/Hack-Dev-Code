{
  "name": "@hackdevcode/dsh-client-ui-open-in-app",
  "description": "Web \"Open In...\" controls: the Session-header split button opening the workspace directory in an installed application, and the document preview's default-application controls for one file",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/client/ui-open-in-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@hackdevcode/dsh-api-gateway",
        "@hackdevcode/dsh-api-remotes",
        "@hackdevcode/dsh-api-session-controller",
        "@hackdevcode/dsh-client-locale",
        "@hackdevcode/dsh-client-shortcuts",
        "@hackdevcode/dsh-client-ui-conversation",
        "@hackdevcode/dsh-client-ui-layout",
        "@hackdevcode/dsh-client-ui-renderer",
        "@hackdevcode/dsh-client-ui-session",
        "@hackdevcode/dsh-client-ui-sidebar-documentpreview"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-api-gateway": "workspace:*",
    "@hackdevcode/dsh-api-remotes": "workspace:*",
    "@hackdevcode/dsh-api-session-controller": "workspace:*",
    "@hackdevcode/dsh-client-locale": "workspace:*",
    "@hackdevcode/dsh-client-store": "workspace:*",
    "@hackdevcode/dsh-client-test-runtime": "workspace:*",
    "@hackdevcode/dsh-client-ui-conversation": "workspace:*",
    "@hackdevcode/dsh-client-ui-layout": "workspace:*",
    "@hackdevcode/dsh-client-ui-primitives": "workspace:*",
    "@hackdevcode/dsh-client-ui-renderer": "workspace:*",
    "@hackdevcode/dsh-client-ui-session": "workspace:*",
    "@hackdevcode/dsh-client-ui-sidebar-documentpreview": "workspace:*",
    "@hackdevcode/dsh-client-ui-sidebar-files": "workspace:*",
    "@hackdevcode/dsh-client-ui-slots": "workspace:*",
    "@hackdevcode/dsh-host-open-in-app": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "react": "^18.2.0",
    "@hackdevcode/dsh-client-ui-deliverables": "workspace:*",
    "@hackdevcode/dsh-native-command": "workspace:*",
    "@hackdevcode/dsh-client-shortcuts": "workspace:*"
  }
}
