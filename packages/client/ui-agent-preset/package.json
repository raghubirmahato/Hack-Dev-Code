{
  "name": "@hackdevcode/dsh-client-ui-agent-preset",
  "description": "Agent-preset surfaces: the default for later sessions, this session's seat, and the composition editor",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/client/ui-agent-preset"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hackdevcode/dsh-api-session-controller",
        "@hackdevcode/dsh-client-connection",
        "@hackdevcode/dsh-client-locale",
        "@hackdevcode/dsh-client-ui-conversation",
        "@hackdevcode/dsh-client-ui-session",
        "@hackdevcode/dsh-client-ui-settings",
        "@hackdevcode/dsh-client-ui-workspace",
        "@hackdevcode/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-agent-preset-registry": "workspace:*",
    "@hackdevcode/dsh-api-remotes": "workspace:*",
    "@hackdevcode/dsh-api-session-controller": "workspace:*",
    "@hackdevcode/dsh-client-connection": "workspace:*",
    "@hackdevcode/dsh-client-locale": "workspace:*",
    "@hackdevcode/dsh-client-product-analytics": "workspace:*",
    "@hackdevcode/dsh-client-store": "workspace:*",
    "@hackdevcode/dsh-client-test-runtime": "workspace:*",
    "@hackdevcode/dsh-client-ui-conversation": "workspace:*",
    "@hackdevcode/dsh-client-ui-plugin-manager": "workspace:*",
    "@hackdevcode/dsh-client-ui-primitives": "workspace:*",
    "@hackdevcode/dsh-client-ui-renderer": "workspace:*",
    "@hackdevcode/dsh-client-ui-session": "workspace:*",
    "@hackdevcode/dsh-client-ui-settings": "workspace:*",
    "@hackdevcode/dsh-client-ui-slots": "workspace:*",
    "@hackdevcode/dsh-client-ui-workspace": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-util-values": "workspace:*",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {}
}
