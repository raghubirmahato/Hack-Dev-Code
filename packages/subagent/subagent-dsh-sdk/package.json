{
  "name": "@hackdevcode/dsh-subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Hack Dev Code runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-sdk-client": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-subprocess": "workspace:*"
  },
  "dependencies": {
    "@hackdevcode/dsh-brand": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/cordis-plugin-loader": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-agent-instructions": "workspace:*",
    "@hackdevcode/dsh-app-boot": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek-api-key": "workspace:*",
    "@hackdevcode/dsh-loader-smoke": "workspace:*",
    "@hackdevcode/dsh-sdk-client": "workspace:*",
    "@hackdevcode/dsh-sdk-protocol": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-session-checkpoint-policy": "workspace:*",
    "@hackdevcode/dsh-session-persistence-jsonl": "workspace:*",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-skill-filesystem": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-subprocess": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tool-subagent": "workspace:*"
  }
}
