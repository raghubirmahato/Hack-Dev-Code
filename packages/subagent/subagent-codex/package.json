{
  "name": "@hackdevcode/dsh-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-subprocess": "workspace:*",
    "@hackdevcode/dsh-timeout": "workspace:*"
  },
  "dependencies": {
    "@hackdevcode/dsh-brand": "workspace:*",
    "@hackdevcode/dsh-sdk-protocol": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@hackdevcode/dsh-tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/cordis-plugin-loader": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-app-boot": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-loader-smoke": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-session-checkpoint-policy": "workspace:*",
    "@hackdevcode/dsh-session-persistence-jsonl": "workspace:*",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-subprocess": "workspace:*",
    "@hackdevcode/dsh-subprocess-local": "workspace:*",
    "@hackdevcode/dsh-timeout": "workspace:*",
    "@hackdevcode/dsh-tool-jobs": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
