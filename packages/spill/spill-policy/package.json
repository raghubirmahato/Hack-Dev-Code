{
  "name": "@hackdevcode/dsh-spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-output-retention": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-spill": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-attachment": "workspace:*",
    "@hackdevcode/dsh-fs": "workspace:*",
    "@hackdevcode/dsh-token-meter": "workspace:*"
  },
  "dependencies": {
    "@hackdevcode/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-ptc-runtime-node": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-output-retention": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-spill": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-fs-local": "workspace:*",
    "@hackdevcode/dsh-subprocess-local": "workspace:*",
    "@hackdevcode/dsh-sandbox-local": "workspace:*",
    "@hackdevcode/dsh-sandbox-policy": "workspace:*",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-attachment": "workspace:*",
    "@hackdevcode/dsh-fs": "workspace:*",
    "@hackdevcode/dsh-token-meter": "workspace:*",
    "@hackdevcode/dsh-mcp-client": "workspace:*",
    "@hackdevcode/dsh-spill-local": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek": "workspace:*",
    "@hackdevcode/dsh-ptc-runtime": "workspace:*",
    "@hackdevcode/dsh-attachment-local": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-executor-ptc": "workspace:*",
    "@hackdevcode/dsh-tool-fs": "workspace:*",
    "sharp": "0.35.5",
    "@hackdevcode/dsh-agent-loop-testkit": "workspace:*"
  }
