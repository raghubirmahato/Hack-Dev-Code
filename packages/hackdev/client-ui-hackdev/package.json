{
  "name": "@hackdevcode/dsh-client-ui-hackdev",
  "description": "Web card for Hack Dev Code missions and gate reviews: tasks, gate verdicts, issues and items needing human approval",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/hackdev/client-ui-hackdev"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hackdevcode/dsh-client-locale",
        "@hackdevcode/dsh-client-ui-renderer",
        "@hackdevcode/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-client-locale": "workspace:*",
    "@hackdevcode/dsh-client-ui-primitives": "workspace:*",
    "@hackdevcode/dsh-client-ui-renderer": "workspace:*",
    "@hackdevcode/dsh-client-ui-slots": "workspace:*",
    "@hackdevcode/dsh-client-ui-tool": "workspace:*",
    "@hackdevcode/dsh-tool-hackdev": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
