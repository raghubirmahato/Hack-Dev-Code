{
  "name": "@hackdevcode/dsh-tool-hackdev",
  "description": "Hack Dev Code mission tools: planning council, parallel builders with shared memory, and verifier, quality/UX and security gates",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/hackdev/tool-hackdev"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tool-workflow": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-workflow": "workspace:*",
    "@hackdevcode/cordis": "workspace:~"
  },
  "dependencies": {
    "@hackdevcode/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tool-workflow": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-workflow": "workspace:*",
    "@hackdevcode/cordis": "workspace:~"
  }
}
