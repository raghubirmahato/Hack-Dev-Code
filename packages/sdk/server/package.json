{
  "name": "@hackdevcode/dsh-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Hack Dev Code SDK clients",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hackdevcode/dsh-brand": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-attachment": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek-api-key": "workspace:*",
    "@hackdevcode/dsh-schedule": "workspace:*",
    "@hackdevcode/dsh-scope": "workspace:*",
    "@hackdevcode/dsh-sdk-protocol": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-user-approval": "workspace:*",
    "@hackdevcode/dsh-user-questions": "workspace:*",
    "@hackdevcode/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/cordis-plugin-loader": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-agent-loop": "workspace:*",
    "@hackdevcode/dsh-agent-loop-testkit": "workspace:*",
    "@hackdevcode/dsh-attachment": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek-api-key": "workspace:*",
    "@hackdevcode/dsh-schedule": "workspace:*",
    "@hackdevcode/dsh-scope": "workspace:*",
    "@hackdevcode/dsh-sdk-protocol": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-session-persistence-jsonl": "workspace:*",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-user-approval": "workspace:*",
    "@hackdevcode/dsh-user-questions": "workspace:*",
    "@hackdevcode/dsh-working-directory": "workspace:*"
  }
}
