{
  "name": "@hackdevcode/dsh-fs",
  "description": "Abstract filesystem capability seam (ctx.fs) for the Hack Dev Code — vocabulary types, the FileSystem service (text IO + optional version-guarded atomic mutations), and the fs/* policy event vocabulary",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/fs/fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/dsh-brand": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-sandbox": "workspace:*",
    "@hackdevcode/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/dsh-brand": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-sandbox": "workspace:*",
    "@hackdevcode/cordis": "workspace:~"
  }
}
