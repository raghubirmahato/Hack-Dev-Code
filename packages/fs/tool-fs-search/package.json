{
  "name": "@hackdevcode/dsh-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@hackdevcode/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-output-retention": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-spill": "workspace:*",
    "@hackdevcode/dsh-subprocess": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-timeout": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-subprocess": "workspace:*",
    "@hackdevcode/dsh-subprocess-local": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-output-retention": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-spill": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-timeout": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-scope": "workspace:*",
    "@hackdevcode/dsh-working-directory": "workspace:*",
    "@hackdevcode/dsh-agent-loop-testkit": "workspace:*"
  }
}
