{
  "name": "@hackdevcode/dsh-llm-replay",
  "description": "Replay LLM plugin: short-circuits llm/stream with model chunks reconstructed from a recorded session JSONL (keyless snapshot tests)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/test-support/llm-replay"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-compaction": "workspace:*",
    "@hackdevcode/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@hackdevcode/dsh-deepseek-llm-api-extensions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-compaction": "workspace:*",
    "@hackdevcode/dsh-deepseek-llm-api-extensions": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*"
  },
  "dependencies": {
    "@hackdevcode/dsh-session-format-catalog": "workspace:*",
    "@hackdevcode/dsh-util-values": "workspace:*"
  }
}
