{
  "name": "@hackdevcode/dsh-mcp-directory",
  "description": "Curated directory of well-known MCP servers and skills: servers mount live as mcp-client instances, skills install into the user skill folder",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/mcp/mcp-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hackdevcode/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-mcp-client": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-home-paths": "workspace:*",
    "@hackdevcode/dsh-credentials": "workspace:*",
    "@hackdevcode/dsh-sandbox": "workspace:*"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/cordis-plugin-loader": "workspace:*",
    "@hackdevcode/cosmokit": "workspace:~",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-mcp-client": "workspace:*",
    "@hackdevcode/dsh-settings": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-home-paths": "workspace:*",
    "@hackdevcode/dsh-credentials": "workspace:*",
    "@hackdevcode/dsh-sandbox": "workspace:*",
    "@hackdevcode/dsh-sandbox-policy": "workspace:*",
    "@hackdevcode/dsh-user-approval": "workspace:*"
  }
}
