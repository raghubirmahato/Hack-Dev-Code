{
  "name": "@hackdevcode/dsh-tool-workflow",
  "description": "Model-facing workflow tool: run a JavaScript orchestration script over ctx.workflowEngine",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/workflow/tool-workflow"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-jobs": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-workflow": "workspace:*"
  },
  "dependencies": {
    "@hackdevcode/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-agent-loop-testkit": "workspace:*",
    "@hackdevcode/dsh-jobs": "workspace:*",
    "@hackdevcode/dsh-jobs-local": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-jobs": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-workflow": "workspace:*",
    "@hackdevcode/dsh-workflow-ptc": "workspace:*"
  }
}
