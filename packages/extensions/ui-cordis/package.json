{
  "name": "@hackdevcode/dsh-client-ui-cordis",
  "description": "Cordis dynamic-plugin definition card: the keyed cordis_define tool row with its run/stop switch",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/extensions/ui-cordis"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@hackdevcode/dsh-client-connection",
        "@hackdevcode/dsh-cordis-client-runner",
        "@hackdevcode/dsh-api-remotes",
        "@hackdevcode/dsh-client-locale",
        "@hackdevcode/dsh-client-ui-renderer",
        "@hackdevcode/dsh-client-ui-session",
        "@hackdevcode/dsh-client-ui-tool",
        "@hackdevcode/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/dsh-api-remotes": "workspace:*",
    "@hackdevcode/dsh-client-connection": "workspace:*",
    "@hackdevcode/dsh-cordis-client-runner": "workspace:*",
    "@hackdevcode/dsh-client-locale": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-client-ui-primitives": "workspace:*",
    "@hackdevcode/dsh-client-ui-sidebar": "workspace:*",
    "@hackdevcode/dsh-client-ui-renderer": "workspace:*",
    "@hackdevcode/dsh-client-ui-session": "workspace:*",
    "@hackdevcode/dsh-client-ui-slots": "workspace:*",
    "@hackdevcode/dsh-client-ui-tool": "workspace:*",
    "@hackdevcode/dsh-util-values": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
