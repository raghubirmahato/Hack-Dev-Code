{
  "name": "@hackdevcode/dsh-web-deepseek-api",
  "description": "DeepSeek Search and Fetch API providers for the Hack Dev Code web capability seam (ctx.web)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/web/web-deepseek-api"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-credentials": "workspace:*",
    "@hackdevcode/dsh-deepseek-account": "workspace:*",
    "@hackdevcode/dsh-launch-environment": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-web": "workspace:*",
    "@hackdevcode/cordis": "workspace:~"
  },
  "dependencies": {
    "@hackdevcode/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-credentials": "workspace:*",
    "@hackdevcode/dsh-credentials-local": "workspace:*",
    "@hackdevcode/dsh-deepseek-account": "workspace:*",
    "@hackdevcode/dsh-launch-environment": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-web": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@hackdevcode/dsh-deepseek-account": {
      "optional": true
    }
  }
}
