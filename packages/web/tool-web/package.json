{
  "name": "@hackdevcode/dsh-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Hack Dev Code web capability seam (ctx.web)",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-web": "workspace:*"
  },
  "dependencies": {
    "@hackdevcode/dsh-output-retention": "workspace:*",
    "@hackdevcode/dsh-util-values": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-spill-local": "workspace:*",
    "@hackdevcode/dsh-spill-policy": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tool-call-timeout-policy": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-web": "workspace:*",
    "@hackdevcode/dsh-web-fetch-http": "workspace:*",
    "@hackdevcode/dsh-web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@hackdevcode/dsh-scope": "workspace:*",
    "@hackdevcode/dsh-token-meter": "workspace:*"
  }
}
