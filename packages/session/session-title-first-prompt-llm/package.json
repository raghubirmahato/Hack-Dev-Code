{
  "name": "@hackdevcode/dsh-session-title-first-prompt-llm",
  "description": "First-message LLM provider plugin for Hack Dev Code session titles",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/session/session-title-first-prompt-llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-session-title": "workspace:*",
    "@hackdevcode/dsh-session-title-llm": "workspace:*",
    "@hackdevcode/cordis": "workspace:~"
  },
  "dependencies": {
    "@hackdevcode/dsh-util-values": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis-plugin-include": "workspace:~",
    "@hackdevcode/cordis-plugin-loader": "workspace:~",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek-api-key": "workspace:*",
    "@hackdevcode/dsh-llm-pi-ai": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-session-title": "workspace:*",
    "@hackdevcode/dsh-session-title-llm": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-agent-loop": "workspace:*"
  }
}
