{
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "name": "@hackdevcode/dsh-client-ui-action-cards",
  "description": "Action cards below completed answers: the shared card frame, kind bodies and the compact tool row",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/experimental/client-ui-action-cards"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@hackdevcode/dsh-api-remotes",
        "@hackdevcode/dsh-client-locale",
        "@hackdevcode/dsh-client-ui-conversation",
        "@hackdevcode/dsh-client-ui-chat",
        "@hackdevcode/dsh-client-ui-session",
        "@hackdevcode/dsh-client-ui-tool"
      ]
    }
  },
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-client-ui-renderer": "workspace:*",
    "@hackdevcode/dsh-api-remotes": "workspace:*",
    "@hackdevcode/dsh-client-locale": "workspace:*",
    "@hackdevcode/dsh-client-ui-conversation": "workspace:*",
    "@hackdevcode/dsh-client-ui-chat": "workspace:*",
    "@hackdevcode/dsh-client-ui-session": "workspace:*",
    "@hackdevcode/dsh-client-ui-slots": "workspace:*",
    "@hackdevcode/dsh-client-ui-primitives": "workspace:*",
    "@hackdevcode/dsh-client-ui-tool": "workspace:*",
    "react": "^18.2.0",
    "@hackdevcode/dsh-action-cards": "workspace:*",
    "@hackdevcode/dsh-typert-protocol": "workspace:*",
    "@hackdevcode/dsh-util-values": "workspace:*",
    "@hackdevcode/dsh-client-test-runtime": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
