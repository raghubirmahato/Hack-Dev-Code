{
  "name": "@hackdevcode/dsh-experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Hack Dev Code Auto permission preset",
  "version": "0.2.2-alpha.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-agent-instructions": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-permission-presets": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@hackdevcode/dsh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-agent-instructions": "workspace:*",
    "@hackdevcode/dsh-agent-loop": "workspace:*",
    "@hackdevcode/dsh-agent-loop-testkit": "workspace:*",
    "@hackdevcode/dsh-bash-sandbox": "workspace:*",
    "@hackdevcode/dsh-compaction": "workspace:*",
    "@hackdevcode/dsh-fs-local": "workspace:*",
    "@hackdevcode/dsh-fs-observation-policy": "workspace:*",
    "@hackdevcode/dsh-fs-sandbox": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek": "workspace:*",
    "@hackdevcode/dsh-llm-deepseek-api-key": "workspace:*",
    "@hackdevcode/dsh-permission-presets": "workspace:*",
    "@hackdevcode/dsh-ptc-runtime-node": "workspace:*",
    "@hackdevcode/dsh-sandbox": "workspace:*",
    "@hackdevcode/dsh-sandbox-policy": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-shell": "workspace:*",
    "@hackdevcode/dsh-shell-env": "workspace:*",
    "@hackdevcode/dsh-subagent": "workspace:*",
    "@hackdevcode/dsh-subprocess-local": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-tool-bash": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-executor-ptc": "workspace:*",
    "@hackdevcode/dsh-tool-fs": "workspace:*",
    "@hackdevcode/dsh-tool-subagent": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-user-approval": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
