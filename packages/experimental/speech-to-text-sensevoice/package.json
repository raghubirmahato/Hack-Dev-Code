{
  "name": "@hackdevcode/dsh-experimental-speech-to-text-sensevoice",
  "description": "Local SenseVoice ONNX transcription with a managed sherpa-onnx process",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/experimental/speech-to-text-sensevoice"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.js",
    "runtime/assets.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hackdevcode/schemastery": "workspace:~",
    "@hackdevcode/dsh-timeout": "workspace:*",
    "zod": "4.4.3",
    "sherpa-onnx-node": "1.13.8"
  },
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-experimental-speech-to-text": "workspace:*",
    "@hackdevcode/dsh-subprocess": "workspace:*"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-experimental-speech-to-text": "workspace:*",
    "@hackdevcode/dsh-subprocess": "workspace:*",
    "@hackdevcode/dsh-subprocess-local": "workspace:*",
    "tsx": "^4.23.13"
  }
}
