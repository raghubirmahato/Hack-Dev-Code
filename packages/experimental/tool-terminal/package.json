{
  "name": "@hackdevcode/dsh-tool-terminal",
  "description": "Six model-facing persistent PTY tools with owner isolation and generic background-job integration",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/experimental/tool-terminal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@hackdevcode/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-terminal": "workspace:*",
    "@hackdevcode/dsh-output-retention": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-jobs": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-working-directory": "workspace:*"
  },
  "devDependencies": {
    "@hackdevcode/cordis-plugin-include": "workspace:~",
    "@hackdevcode/cordis-plugin-loader": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-agent-loop-testkit": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-terminal": "workspace:*",
    "@hackdevcode/dsh-terminal-bash": "workspace:*",
    "@hackdevcode/dsh-output-retention": "workspace:*",
    "@hackdevcode/dsh-sandbox": "workspace:*",
    "@hackdevcode/dsh-sandbox-policy": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-subprocess-local": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-jobs": "workspace:*",
    "@hackdevcode/dsh-jobs-local": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-executor-ptc": "workspace:*",
    "@hackdevcode/dsh-tool-jobs": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-session-projection": "workspace:*",
    "@hackdevcode/dsh-working-directory": "workspace:*"
  }
}
