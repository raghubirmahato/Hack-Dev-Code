{
  "name": "@hackdevcode/dsh-tool-lsp",
  "description": "Model-facing lsp tool over the Hack Dev Code LSP capability seam (ctx.lsp) \u2014 one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-lsp": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-timeout": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-working-directory": "workspace:*"
  },
  "dependencies": {
    "@hackdevcode/dsh-util-values": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-fs-local": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-lsp": "workspace:*",
    "@hackdevcode/dsh-lsp-stdio": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-subprocess-local": "workspace:*",
    "@hackdevcode/dsh-system-prompt": "workspace:*",
    "@hackdevcode/dsh-timeout": "workspace:*",
    "@hackdevcode/dsh-tool-call-timeout-policy": "workspace:*",
    "@hackdevcode/dsh-tool-executor-native": "workspace:*",
    "@hackdevcode/dsh-tool-testkit": "workspace:*",
    "@hackdevcode/dsh-tools": "workspace:*",
    "@hackdevcode/dsh-working-directory": "workspace:*",
    "@hackdevcode/dsh-agent-loop-testkit": "workspace:*"
  }
}
