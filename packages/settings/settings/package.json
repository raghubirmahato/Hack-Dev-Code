{
  "name": "@hackdevcode/dsh-settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Hack Dev Code",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-brand": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-brand": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/schemastery": "workspace:~",
    "@hackdevcode/cordis-plugin-timer": "workspace:~",
    "@hackdevcode/dsh-app-boot": "workspace:*",
    "@hackdevcode/dsh-hmr": "workspace:*",
    "@hackdevcode/dsh-agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@hackdevcode/dsh-util-values": "workspace:*",
    "@hackdevcode/dsh-config-editor": "workspace:*",
    "@hackdevcode/cordis-plugin-loader": "workspace:~",
    "@hackdevcode/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
