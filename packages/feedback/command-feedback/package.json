{
  "name": "@hackdevcode/dsh-command-feedback",
  "description": "Log-only session feedback: the record event, the sessionFeedback Host Remote, and the human-facing slash command",
  "version": "0.2.2-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hack-dev-code/hack-dev-code.git",
    "directory": "packages/feedback/command-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hackdevcode/dsh-commands": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-anonymous-user-id": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-typert-protocol": "workspace:*"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@hackdevcode/cordis-plugin-include": "workspace:~",
    "@hackdevcode/cordis-plugin-loader": "workspace:~",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-agent-loop-testkit": "workspace:*",
    "@hackdevcode/dsh-commands": "workspace:*",
    "@hackdevcode/dsh-llm": "workspace:*",
    "@hackdevcode/dsh-session": "workspace:*",
    "@hackdevcode/dsh-anonymous-user-id": "workspace:*",
    "@hackdevcode/cordis": "workspace:~",
    "@hackdevcode/dsh-typert-protocol": "workspace:*"
  }
}
