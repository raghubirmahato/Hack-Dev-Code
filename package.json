    "@hackdevcode/dsh-tool-executor-ptc": "workspace:*",
    "@hackdevcode/dsh-tool-ralph": "workspace:*",
    "@hackdevcode/dsh-tool-terminal": "workspace:*",
    "@hackdevcode/dsh-agent": "workspace:*",
    "@hackdevcode/dsh-browser-use": "workspace:*",
    "@hackdevcode/dsh-experimental-browser-use-runtime": "workspace:*",
    "@hackdevcode/dsh-experimental-browser-use-playwright-mcp": "workspace:*",
    "@hackdevcode/dsh-experimental-browser-use-chrome-devtools-mcp": "workspace:*",
    "@hackdevcode/dsh-experimental-browser-use-stagehand-native": "workspace:*",
    "@hackdevcode/dsh-computer-use": "workspace:*",
    "@hackdevcode/dsh-experimental-computer-use-cua-driver-mcp": "workspace:*",
    "@hackdevcode/dsh-experimental-computer-use-cua-driver-native": "workspace:*",
