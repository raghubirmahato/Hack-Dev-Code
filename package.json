    "spdx-expression-parse": "^5.0.0",
    "tar": "^7.5.22",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "@hackdevcode/dsh-skill-office": "workspace:*",
    "@hackdevcode/dsh-tool-workspace-dependencies": "workspace:*",
